# Dependencies
node_modules

# Development files
.git
.github
.vscode
.idea

# Documentation and examples
*.md
README.md
docs/
.env.example

# Sensitive files — never bake into the image
# cookies.txt is mounted as a volume at runtime (see docker-compose.yml)
cookies.txt
.env

# Test files
test/
tests/
*.test.js
*.spec.js

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo
.wh..*

# Session data (generated at runtime, mounted as Docker volume)
.wwebjs_auth/
.wwebjs_cache/

# Python venv (rebuilt for Linux inside Docker)
src/scripts/.venv/

# Scripts for local development only
start-bot.sh
