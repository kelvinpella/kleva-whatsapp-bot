# Production environment for the Kleva WhatsApp bot (Contabo / Docker Compose).
# Copy to .env on the server and fill in real values. Do NOT commit .env.
#
# NOTE: NODE_ENV, REDIS_URL and PUPPETEER_EXECUTABLE_PATH are set automatically
# by docker-compose.yml — you do not need to set them here.

# WhatsApp
YOUR_PHONE_NUMBER=+255XXXXXXXXXX
# Comma-separated, format: GroupName:GroupID@g.us  (or just GroupID@g.us)
ALLOWED_GROUPS=Kleva Pochi Kali:120363XXXXXXXXXXXX@g.us
# WhatsApp number to notify after each post (include country code, @c.us suffix)
NOTIFICATION_NUMBER=255XXXXXXXXX@c.us

# Matching configuration
CLEANUP_DAYS=30
MIN_SIMILARITY=0.70
SEMANTIC_WEIGHT=0.60
TEXTURE_WEIGHT=0.25
COLOR_WEIGHT=0.15

# Image processing & validation
HANDBAG_CONFIDENCE_THRESHOLD=0.5
MAX_IMAGES_PER_MESSAGE=2
MAX_IMAGE_SIZE_KB=5000

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_key
SUPABASE_STORAGE_BUCKET=handbags

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Zernio (TikTok/Instagram scheduling)
ZERNIO_API_KEY=your_zernio_api_key
ZERNIO_TIKTOK_ACCOUNT_ID=your_tiktok_account_id
ZERNIO_INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# TikTok uploader cookies path (if used)
TIKTOK_COOKIES_PATH=cookies.txt

# Fal AI (post title / description generation)
FAL_KEY=your_fal_key
